# Tasheel environment configuration.
#
# Copy to .env and fill in. For local development, prefer .env.local so you cannot
# accidentally point a development run at production — see the local database section below.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Direct connection. Used by migrations.
DATABASE_URL="postgres://[user]:[password]@db.prisma.io:5432/postgres?sslmode=require"

# Pooled connection, used by the application at runtime. Add &pgbouncer=true.
# Leave empty to fall back to DATABASE_URL.
DATABASE_URL_POOLED=""

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# This signs every session token. A guessable value means anyone can forge a session
# for any user, so it must be random — not a memorable phrase.
NEXTAUTH_SECRET=""

# The canonical origin. Must match how users reach the app, or callbacks break.
NEXTAUTH_URL="http://localhost:3000"

# Used to build links in outgoing email. Falls back to the production URL if unset,
# which means development emails would link to the live site.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Object storage (required for uploads)
# ---------------------------------------------------------------------------
# The bucket must have public access BLOCKED. Files are served through
# /api/files/[uploadId], which checks branch access and issues a short-lived signed URL.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_REGION="ap-southeast-1"
AWS_S3_BUCKET_NAME=""

# ---------------------------------------------------------------------------
# Email (required for onboarding and password reset)
# ---------------------------------------------------------------------------
# Without this, verification and reset emails fail. Account creation still succeeds,
# so the failure is easy to miss.
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Rate limiting and caching (strongly recommended in production)
# ---------------------------------------------------------------------------
# Without Upstash, rate limiting falls back to an in-process store. That is per-instance,
# so on serverless it is only as effective as the number of warm instances is small —
# adequate for local development, not a production control. Caching is a no-op without it.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Maps (required for the address picker)
# ---------------------------------------------------------------------------
# Restrict this key by HTTP referrer. The geocode proxy requires a session and applies a
# rate limit, but a leaked key can still be used directly against Google.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------------------
# Scheduled jobs (required in production)
# ---------------------------------------------------------------------------
# Vercel sends this as a bearer token to the cron routes. They refuse to run without it.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Error monitoring (optional, recommended)
# ---------------------------------------------------------------------------
# Unset means no error monitoring at all. Also set `org` and `project` in next.config.ts.
NEXT_PUBLIC_SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Local development database
# ---------------------------------------------------------------------------
# Rather than pointing a local run at production, run a throwaway Postgres:
#
#   node scripts/dev-db.mjs init      # once
#   node scripts/dev-db.mjs start
#   npx prisma migrate deploy
#   npx tsx prisma/seed-dev.ts
#
# then put this in .env.local, which Next.js loads ahead of .env and git ignores:
#
#   DATABASE_URL="postgresql://tasheel:tasheel@localhost:55432/tasheel_dev"
